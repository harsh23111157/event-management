# Django Application Configuration

# General
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-for-security
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgres://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventops

# SQLite Alternative (for quick testing/development):
# DATABASE_URL=sqlite:///db.sqlite3

# OpenRouter AI Assistant Configuration (Optional)
# Leave OPENROUTER_API_KEY blank if you are not using AI features.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
